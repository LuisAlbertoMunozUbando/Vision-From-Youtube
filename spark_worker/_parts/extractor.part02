    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error"]
    hw = list(hw)
    if keyframes:
        cmd += ["-skip_frame", "nokey"]
        hw = []
    if seek:
        cmd += ["-ss", f"{seek:.3f}"]
    cmd += hw + ["-i", src]
    if dur:
        cmd += ["-t", f"{dur:.3f}"]
    chain = []
    if fps and not keyframes:
        chain.append(f"fps={fps}")
    if keyframes:
        chain.append(f"scale={w}:{h}:flags=area")
        pix = "gray"
        cmd += ["-fps_mode", "passthrough"]
    else:
        chain.append(vf.format(w=w, h=h))
    cmd += ["-an", "-sn", "-vf", ",".join(chain), "-f", "rawvideo", "-pix_fmt", pix, "pipe:1"]
    return cmd, pix


class GrayReader:
    def __init__(self, src, w, h, fps=None, seek=None, dur=None, keyframes=False, variant=None):
        self.w, self.h = w, h
        self.variant = variant or DECODER
        self.cmd, self.pix = _build_cmd(self.variant, src, w, h, fps, seek, dur, keyframes)
        self.fsz = w * h * 3 // 2 if self.pix == "nv12" else w * h
        self.proc = subprocess.Popen(self.cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=10**8)

    def read_batch(self, n):
        raw = self.proc.stdout.read(self.fsz * n)
        got = len(raw) // self.fsz
        if got == 0:
            return None
        a = np.frombuffer(raw[:got * self.fsz], np.uint8)
        if self.pix == "nv12":
            a = a.reshape(got, self.h * 3 // 2, self.w)[:, :self.h, :]
        else:
            a = a.reshape(got, self.h, self.w)
        return np.ascontiguousarray(a)

    def close(self):
        try:
            self.proc.stdout.close()
            self.proc.kill()
        except Exception:
            pass


def choose_decoder():
    global DECODER
    for cand in _decoder_variants():
        try:
            r = GrayReader(SRC, ANALYSIS_W, ANALYSIS_H, fps=1.0, dur=4.0, variant=cand)
            b = r.read_batch(2)
            r.close()
            if b is not None and b.shape[0] >= 1 and b.std() > 0:
                DECODER = cand
                print(f"decoder: {cand[0]}")
                return
        except Exception as e:
            print(f"decoder candidate {cand[0]} failed: {e}")
    raise RuntimeError("No working ffmpeg decode path. Check `ffmpeg -hwaccels`.")


def grab_bgr(t, w=None, h=None):
    w = w or NATIVE_W
    h = h or NATIVE_H
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-ss", f"{max(t,0):.3f}",
           "-i", SRC, "-frames:v", "1", "-an", "-sn", "-f", "rawvideo", "-pix_fmt", "bgr24", "pipe:1"]
    out = subprocess.run(cmd, capture_output=True, timeout=180).stdout
    need = w * h * 3
    if len(out) < need:
        return None
    return np.frombuffer(out[:need], np.uint8).reshape(h, w, 3)


