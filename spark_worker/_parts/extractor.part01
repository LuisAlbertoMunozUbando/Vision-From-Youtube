def fmt_t(sec: float) -> str:
    h, r = divmod(int(sec), 3600)
    m, s = divmod(r, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


def write_status(stage: str, progress: float, message: str, **extra) -> None:
    if STATUS_FILE is None:
        return
    payload = {
        "stage": stage,
        "progress": max(0.0, min(float(progress), 100.0)),
        "message": message,
        "updated_at": time.time(),
        **extra,
    }
    tmp = STATUS_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(STATUS_FILE)


def run(cmd, timeout=None):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def require_tools() -> None:
    missing = [x for x in ("yt-dlp", "ffmpeg", "ffprobe") if shutil.which(x) is None]
    if missing:
        raise RuntimeError(f"Missing required tools: {', '.join(missing)}")


def yt_dlp_base() -> list[str]:
    """Common yt-dlp flags for current YouTube JS challenge handling.

    Deno is preferred because it is the runtime recommended by yt-dlp for EJS.
    We use an explicit path so the systemd worker does not depend on an
    interactive-shell PATH.
    """
    cmd = ["yt-dlp", "--ignore-config", "--no-playlist"]
    deno = Path.home() / ".deno" / "bin" / "deno"
    if deno.exists():
        cmd += ["--js-runtimes", f"deno:{deno}", "--remote-components", "ejs:github"]
    return cmd


def init_gpu() -> None:
    global DEVICE
    if torch.cuda.is_available():
        DEVICE = "cuda"
        torch.cuda.set_device(0)
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cudnn.allow_tf32 = True
        torch.backends.cudnn.benchmark = True
        p = torch.cuda.get_device_properties(0)
        print(f"CUDA: {p.name} | cc {p.major}.{p.minor} | torch {torch.__version__} / CUDA {torch.version.cuda}")
    elif REQUIRE_GPU:
        raise RuntimeError("CUDA is not available to PyTorch. Check nvidia-smi and the CUDA build of torch.")
    else:
        DEVICE = "cpu"


def get_video_metadata(url: str, max_minutes: int) -> dict:
    """Read public metadata without relying on yt-dlp's default format choice."""
    cmd = yt_dlp_base() + [
        "--skip-download", "--no-warnings",
        "--no-check-formats", "--ignore-no-formats-error", "-f", "all",
        "--dump-single-json", url,
    ]
    r = run(cmd, timeout=120)
    if r.returncode != 0:
        raise RuntimeError(f"yt-dlp could not read the video metadata: {r.stderr[-600:]}")
    info = json.loads(r.stdout)
    duration = float(info.get("duration") or 0)
    if info.get("is_live") or info.get("live_status") == "is_live":
        raise RuntimeError("Live streams that are still broadcasting are not accepted. Wait until the stream is archived, then process the archived video.")
    if max_minutes > 0 and duration > max_minutes * 60:
        raise RuntimeError(f"Video is {duration/60:.1f} min; service limit is {max_minutes} min.")
    return info


def download_source(url: str, work_dir: Path, max_height: int) -> tuple[str, dict]:
    info = get_video_metadata(url, int(os.getenv("MAX_VIDEO_MINUTES", "180")))
    # Prefer a video stream at or below MAX_HEIGHT, but always fall back to the
    # best format yt-dlp can obtain. This avoids hard failures on archived live
    # streams and videos whose available representations do not match 1080p.
    fmt = f"bv*[height<={max_height}]+ba/b[height<={max_height}]/bv*+ba/b"
    out_tpl = str(work_dir / "source.%(ext)s")
    cmd = yt_dlp_base() + [
        "-f", fmt, "--no-warnings", "--merge-output-format", "mkv",
        "--write-info-json", "-o", out_tpl, url,
    ]
    write_status("download", 3, "Descargando video de YouTube", title=info.get("title"))
    r = subprocess.run(cmd)
    if r.returncode != 0:
        raise RuntimeError("yt-dlp failed to download the source video.")
    for ext in ("mp4", "mkv", "webm"):
        cand = work_dir / f"source.{ext}"
        if cand.exists():
            return str(cand), info
    candidates = [p for p in work_dir.glob("source.*") if not p.name.endswith(".json") and p.is_file()]
    if not candidates:
        raise RuntimeError("Download finished but no source video was found.")
    return str(candidates[0]), info


def probe_source(src: str) -> tuple[int, int, float]:
    pr = run([
        "ffprobe", "-v", "error", "-select_streams", "v:0",
        "-show_entries", "stream=width,height,avg_frame_rate:format=duration",
        "-of", "json", src,
    ], timeout=120)
    if pr.returncode != 0:
        raise RuntimeError(f"ffprobe failed: {pr.stderr[-500:]}")
    meta = json.loads(pr.stdout)
    st = meta["streams"][0]
    return int(st["width"]), int(st["height"]), float(meta["format"].get("duration") or 0)


# ---------------------------------------------------------------------------
# Decoder (notebook cell 4)
# ---------------------------------------------------------------------------
def _decoder_variants():
    v = []
    if USE_NVDEC and DEVICE == "cuda":
        v.append(("nvdec+scale_cuda",
                  ["-hwaccel", "cuda", "-hwaccel_output_format", "cuda"],
                  "scale_cuda={w}:{h}:format=nv12,hwdownload,format=nv12", "nv12"))
        v.append(("nvdec+cpu-scale", ["-hwaccel", "cuda"],
                  "scale={w}:{h}:flags=area", "gray"))
    v.append(("cpu", [], "scale={w}:{h}:flags=area", "gray"))
    return v


