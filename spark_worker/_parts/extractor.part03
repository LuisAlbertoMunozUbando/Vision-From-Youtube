        if ADAPT_NOISE and len(self.noise_p) >= 12:
            tp = max(tp, min(0.12, NOISE_MULT * float(np.median(self.noise_p))))
            ti = max(ti, min(0.30, NOISE_MULT * float(np.median(self.noise_i))))
        return tp, ti

    def _close(self):
        c, self.cur = self.cur, None
        if c is None:
            return
        dur = c["t_last"] - c["t_start"] + self.dt
        if dur < MIN_SLIDE_SECONDS or c["n_stable"] * self.dt < MIN_STABLE_SEC:
            self.rejected.append((c["t_start"], f"too short ({dur:.1f}s)"))
            return
        tp, ti = self.thresholds()
        for s in self.saved_sigs:
            dp, di = sig_diff(c["sig"], s)
            if dp < tp * DEDUP_MULT and di < ti * DEDUP_MULT:
                self.rejected.append((c["t_start"], "already captured"))
                return
        self.saved_sigs.append(c["sig"])
        c["duration"] = dur
        self.segments.append(c)

    def _open(self, t, sig, box, area):
        self.cur = {"t_start": t, "t_last": t, "t_settled": t, "n_stable": 1,
                    "sig": sig, "box": box, "area": area, "builds": 0}

    def push(self, t, area, box, fill, detail, gray_1hw):
        ok = (box is not None and area >= MIN_SLIDE_AREA and fill >= MIN_FILL_RATIO and detail >= MIN_DETAIL)
        if ok:
            ar = (box[2] - box[0]) / max(box[3] - box[1], 1e-6)
            ok = ASPECT_RANGE[0] <= ar <= ASPECT_RANGE[1]
        if not ok:
            self._close(); self.prev_sig, self.prev_box = None, None; return
        grew = False
        if self.cur is not None:
            cb, sl = self.cur["box"], 1.5 / GRID_COLS
            if (box[0] <= cb[0]+sl and box[1] <= cb[1]+sl and box[2] >= cb[2]-sl
                    and box[3] >= cb[3]-sl
                    and (box[2]-box[0])*(box[3]-box[1]) > 1.05*(cb[2]-cb[0])*(cb[3]-cb[1])):
                self.cur["box"] = (min(cb[0], box[0]), min(cb[1], box[1]), max(cb[2], box[2]), max(cb[3], box[3]))
                grew = True
            box = self.cur["box"]
        sig = signature(gray_1hw, box)
        if self.prev_sig is not None and self.prev_box == box:
            dp0, di0 = sig_diff(sig, self.prev_sig)
            self.noise_p.append(dp0); self.noise_i.append(di0)
        self.prev_sig, self.prev_box = sig, box
        if self.cur is None:
            self._open(t, sig, box, area); return
        if grew:
            self.cur.update(sig=sig, t_last=t, area=max(self.cur["area"], area)); self.cur["n_stable"] += 1; return
        d_pix, d_ink = sig_diff(sig, self.cur["sig"])
        t_pix, t_ink = self.thresholds()
        if d_pix <= t_pix and d_ink <= t_ink:
            self.cur["t_last"] = t; self.cur["n_stable"] += 1; self.cur["area"] = max(self.cur["area"], area)
        elif MERGE_BUILDS and d_pix <= BUILD_DIFF and is_build(self.cur["sig"], sig):
            self.cur.update(sig=sig, t_last=t, t_settled=t, n_stable=1, area=max(self.cur["area"], area)); self.cur["builds"] += 1
        else:
            self._close(); self._open(t, sig, box, area)

    def finish(self):
        self._close(); return self.segments


# ---------------------------------------------------------------------------
# Pass A / Pass B
# ---------------------------------------------------------------------------
def build_content_mask():
    global CONTENT
    write_status("pass_a", 15, "Pass A: aprendiendo dónde puede aparecer la pantalla")
    rd = GrayReader(SRC, ANALYSIS_W, ANALYSIS_H, keyframes=True, dur=None)
    keys = []
    try:
        while True:
            b = rd.read_batch(BATCH_FRAMES)
            if b is None: break
            keys.append(b)
            if sum(k.shape[0] for k in keys) >= 1500: break
    finally:
        rd.close()
    keyframes = np.concatenate(keys, 0) if keys else np.zeros((0, ANALYSIS_H, ANALYSIS_W), np.uint8)
    CONTENT = torch.ones((GRID_ROWS, GRID_COLS), dtype=torch.bool, device=DEVICE)
    if REGION_MODE == "auto" and len(keyframes) >= 8:
        means = []
        for s in range(0, len(keyframes), BATCH_FRAMES):
            m, _ = cell_stats(to_gpu(keyframes[s:s + BATCH_FRAMES])); means.append(m)
        M = torch.cat(means, 0); var = M.std(0)
        thr = max(CONTENT_ABS, CONTENT_REL * float(torch.quantile(var.flatten().float(), 0.90)))
        raw = (var >= thr).to(torch.uint8).cpu().numpy()
        CONTENT = torch.from_numpy(close_and_fill(raw, CONTENT_CLOSE)).to(DEVICE).bool()
    elif REGION_MODE == "manual":
        x0, y0, x1, y1 = MANUAL_REGION
        g = torch.zeros((GRID_ROWS, GRID_COLS), dtype=torch.bool, device=DEVICE)
        g[int(y0*GRID_ROWS):max(int(y1*GRID_ROWS), 1), int(x0*GRID_COLS):max(int(x1*GRID_COLS), 1)] = True
        CONTENT = g


def iou(a, b):
    ix = max(0.0, min(a[2], b[2]) - max(a[0], b[0])); iy = max(0.0, min(a[3], b[3]) - max(a[1], b[1]))
    inter = ix * iy
    ua = (a[2]-a[0])*(a[3]-a[1]) + (b[2]-b[0])*(b[3]-b[1]) - inter
    return inter / ua if ua > 0 else 0.0


def enforce_layout(segments):
    if not CONSISTENT_LAYOUT or len(segments) < 3:
        return segments, []
    w = np.array([s["duration"] for s in segments], dtype=np.float64)
    B = np.array([s["box"] for s in segments], dtype=np.float64)
    order = np.argsort(w)[::-1]
    ref = tuple(np.median(B[order[:max(3, len(order)//2)]], axis=0))
    keep, drop = [], []
    for s in segments:
        s["box_own"] = s["box"]
        if iou(s["box"], ref) >= LAYOUT_IOU:
            s["box"] = ref; keep.append(s)
        else:
            drop.append(s)
    return keep, drop


def analyze():
    K_WIN = max(2, int(round(STATIC_WINDOW_SEC * ANALYSIS_FPS)) + 1)
    DT = 1.0 / ANALYSIS_FPS
    rd = GrayReader(SRC, ANALYSIS_W, ANALYSIS_H, fps=ANALYSIS_FPS)
    seg = SlideSegmenter(DT)
    carry, i = None, 0
    expected = max(1, int(DURATION * ANALYSIS_FPS))
    try:
        while True:
            batch = rd.read_batch(BATCH_FRAMES)
            if batch is None: break
            x = to_gpu(batch); m, d = cell_stats(x)
            static, carry = rolling_static(m, carry, K_WIN, STATIC_EPS)
            masks = (static & CONTENT.unsqueeze(0)).to(torch.uint8).cpu().numpy()
            det_np, stat_np, mean_np = d.cpu().numpy(), static.cpu().numpy(), m.cpu().numpy()
            for j in range(batch.shape[0]):
                t = i * DT
                r = largest_block(masks[j], det_np[j])
                if r is None:
                    seg.push(t, 0.0, None, 0.0, 0.0, None)
                else:
                    a_cells, bb, fill, det = r
                    if EXPAND_MARGINS: bb = expand_box(bb, stat_np[j], mean_np[j])
                    box = (bb[0]/GRID_COLS, bb[1]/GRID_ROWS, bb[2]/GRID_COLS, bb[3]/GRID_ROWS)
                    seg.push(t, a_cells/(GRID_ROWS*GRID_COLS), box, fill, det, x[j, 0].unsqueeze(0))
                i += 1
            pct = 20 + 55 * min(i / expected, 1.0)
            write_status("pass_b", pct, f"Pass B: analizando {fmt_t(i*DT)} / {fmt_t(DURATION)}", slides_detected=len(seg.segments))
